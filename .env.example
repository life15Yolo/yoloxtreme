# Public client settings. These are not admin authority.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix this with NEXT_PUBLIC and never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Supabase Auth emails allowed to review drops.
# Leave empty to fail closed. Do not guess an address and do not use designer.verified.
ADMIN_EMAIL_ALLOWLIST=

# Leave unset. Checkout stays closed, including when a live Paystack secret exists.
# The only non-closed value is test, and the server still rejects secrets that start with sk_live_.
PAYMENTS_MODE=
